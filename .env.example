# VCPeer Live - environment template. Copy to .env and fill in real
# values before `docker compose up`. Never commit a filled-in .env.

# --- Control app ---
VCPEER_LIVE_ENV=dev                       # "dev" echoes magic-sign-in links back in the API response when SMTP isn't configured; use "production" on the real box
PUBLIC_URL=http://localhost:4000          # base URL the control app is reachable at (used to build magic-link URLs)
RTMP_PUBLIC_URL=rtmp://localhost:1935     # public RTMP ingest URL shown to users for OBS
WHIP_PUBLIC_URL=http://localhost:8889     # public WHIP ingest URL used for browser go-live
OWNCAST_PUBLIC_URL=http://localhost:8080  # public watch page URL
OWNCAST_STREAM_KEY=abc123                 # must match owncast-init's OWNCAST_STREAM_KEY below
CONTROL_PORT=4000

# --- Twitch OAuth ("Connect Twitch" button, optional) ---
# Free Twitch Developer Console app (console.twitch.tv/console/apps) -
# OAuth Redirect URL must be exactly "${PUBLIC_URL}/api/oauth/twitch/callback".
# Leave both blank to keep the manual "paste RTMP URL + key" destination
# form as the only way to add a Twitch destination - nothing breaks
# without these, "Connect Twitch" just won't be offered.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Dodo Payments (Pro subscription + team seats, optional) ---
# Reuses the vcpeer business/brand's business-wide live API key (see
# ~/products/memory/dodo-business-brands-structure-2026-10-21.md) - do not
# provision a new Dodo account. Leave all four blank to keep every account
# on the free plan forever; "Upgrade to Pro" is hidden until configured.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PAYMENTS_TEST_MODE=false

# 64 hex chars (32 bytes) - generate with: openssl rand -hex 32
# Encrypts every destination's stream key at rest (AES-256-GCM). Losing
# this key makes stored destinations unrecoverable; rotating it requires
# re-entering every destination's stream key.
ENCRYPTION_KEY=

# --- Scribase Mail SMTP (magic-link sign-in email) ---
# Placeholders - leave blank for local/dev; the control app falls back to
# returning the sign-in link directly in the API response when
# VCPEER_LIVE_ENV=dev and SMTP is unset.
SMTP_HOST=mail.scribase.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VCPeer Live <live@vcpeer.com>

# --- Owncast ---
OWNCAST_WEB_PORT=8080
OWNCAST_RTMP_PORT=1937
OWNCAST_ADMIN_PASSWORD=abc123             # change before any public deploy

# --- MediaMTX (ingest + fan-out) ---
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_WHIP_PORT=8889
MEDIAMTX_WHIP_UDP_PORT=8189
MEDIAMTX_API_PORT=9997
MEDIAMTX_WEBRTC_HOST=127.0.0.1                  # local proof value; set to the box's public IP/hostname in production (see deploy/RUNBOOK.md)

# --- Local proof only (docker compose --profile proof up) ---
MEDIAMTX_FAKE_RTMP_PORT=1936
MEDIAMTX_FAKE_API_PORT=9998
